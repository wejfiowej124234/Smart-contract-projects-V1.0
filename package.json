{
  "name": "coding-test-hardhat-part1",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "cookie": "1.1.1",
    "tmp": "0.2.5",
    "undici": "6.23.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.10",
    "@openzeppelin/contracts": "^4.9.6",
    "@types/node": "^22.0.0",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "ethers": "6.14.0",
    "hardhat": "2.28.3",
    "mocha": "^10.8.2",
    "solc": "^0.8.19",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "@marp-team/marp-cli": "^4.2.3",
    "@playwright/test": "^1.49.0"
  },
  "scripts": {
    "compile": "hardhat compile",
    "clean": "hardhat clean",
    "node": "hardhat node",
    "diagnose:dashboard": "hardhat run scripts/diagnose-dashboard-read.ts --network localhost",
    "verify:consistency": "node scripts/verify-local-chain-consistency.mjs",
    "sentinel:read": "hardhat run scripts/sentinel-read-diagnostic.ts --network localhost",
    "deploy:localhost": "hardhat run scripts/deploy/deploy.ts --network localhost",
    "deploy:p9": "hardhat run scripts/deploy/deploy-p9.ts --network localhost",
    "governance:transfer-admin": "hardhat run scripts/governance/transfer-admin-to-timelock.ts --network localhost",
