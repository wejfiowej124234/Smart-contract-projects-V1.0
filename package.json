    "governance:ensure-and-run": "npm run governance:transfer-admin && npm run governance:first-proposal",
    "governance:full-lifecycle-evidence": "hardhat run scripts/governance/full-lifecycle-evidence-pack.ts --network localhost",
    "governance:audit-log": "hardhat run scripts/governance/governance-audit-log.ts --network localhost",
    "governance:verify-snapshot-safety": "hardhat run scripts/governance/verify-voting-snapshot-safety.ts --network localhost",
    "governance:proposal-upgrade-params": "hardhat run scripts/governance/proposal-upgrade-governance-params.ts --network localhost",
    "governance:verify-recovery-paths": "hardhat run scripts/governance/verify-recovery-paths.ts --network localhost",
    "governance:risk-simulate-params": "hardhat run scripts/governance/risk-simulate-params.ts --network localhost",
    "governance:verify-p9": "hardhat run scripts/governance/verify-p9-complete.ts --network localhost",
    "governance:verify-guardian": "hardhat run scripts/governance/verify-guardian-emergency-pause.ts --network localhost",
    "ops:fix-supply-revert": "hardhat run scripts/ops/fix-supply-revert-31337.ts --network localhost",
    "governance:second-proposal-setlt": "hardhat run scripts/governance/second-proposal-setlt.ts --network localhost",
    "governance:proxy-upgrade-drill": "hardhat run scripts/governance/proxy-upgrade-drill.ts --network localhost",
    "p9:full": "npm run deploy:p9 && npm run governance:transfer-admin && npm run governance:first-proposal && npm run governance:verify-p9",
    "p10:ci": "node scripts/ci/run-p10-full.mjs",
    "p10:evidence-pack": "node scripts/ci/generate-evidence-pack.mjs",
    "p10:evidence-screenshot": "node scripts/ci/capture-dashboard-kpi-screenshot.mjs",
    "p10:gate": "node scripts/ci/p10-local-only-gate.mjs",
    "release-proof": "node scripts/ci/p10-local-only-gate.mjs",
    "release-proof:report": "node scripts/ci/release-proof-report.mjs",
    "demo:chain": "node scripts/demo/start-local-chain.mjs",
    "demo:frontend": "node scripts/demo/start-frontend.mjs",
    "local:prereq": "node scripts/demo/run-local-prereq.mjs",
    "local:align": "npm run deploy:localhost && npm run deploy:p9 && npm run verify:consistency",
    "local:restart": "powershell -ExecutionPolicy Bypass -File scripts/local-restart.ps1",
    "e2e:ui": "node scripts/ci/run-e2e-ui.mjs -- --project=chromium",
    "e2e:smoke": "node scripts/ci/run-e2e-ui.mjs -- --project=smoke",
    "e2e:core": "node scripts/ci/run-e2e-ui.mjs -- --project=smoke --project=core-flow",
    "e2e:tx-heavy": "node scripts/ci/run-e2e-ui.mjs -- --project=tx-heavy",
    "e2e:nightly": "node scripts/ci/run-e2e-ui.mjs -- --project=chromium",
    "test": "hardhat test",
    "test:gate-validation": "node test/unit/validate-evidence-summary.test.mjs",
    "test:invariant": "hardhat test --grep \"Invariants\"",
    "test:fuzz": "hardhat test --grep \"Fuzz\"",
    "liquidation-bot": "hardhat run scripts/run-liquidation-bot.ts",
    "run:liquidation-bot": "hardhat run scripts/run-liquidation-bot.ts",
    "scenario:crash50": "hardhat run scenarios/crash50.ts --network localhost",
    "scenario:stale": "hardhat run scenarios/stale.ts --network localhost",
    "scenario:high-util": "hardhat run scenarios/high-util.ts --network localhost",
    "scenario:reset": "hardhat run scenarios/reset.ts --network localhost",
    "scenario:crash50-demo": "hardhat run scenarios/crash50-liquidation-demo.ts --network localhost",
    "test:frontend": "cd frontend && npm test",
    "test:e2e": "npm run -s smoke:e2e",
    "test:all": "npm run -s test && npm run -s test:frontend && npm run -s test:e2e",
    "audit:prod": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "slides:pdf": "marp slides/INTERVIEW_DECK.en.md --pdf --allow-local-files --pdf-outlines --output slides/dist/INTERVIEW_DECK.en.pdf",
    "slides:pdf:zh": "marp slides/INTERVIEW_DECK.zh-cn.md --pdf --allow-local-files --pdf-outlines --output slides/dist/INTERVIEW_DECK.zh-cn.pdf",
    "slides:pdf:all": "npm run slides:pdf:zh && npm run slides:pdf",
    "slides:html": "marp slides/INTERVIEW_DECK.en.md --html --allow-local-files --output slides/dist/INTERVIEW_DECK.en.html",
    "slides:html:zh": "marp slides/INTERVIEW_DECK.zh-cn.md --html --allow-local-files --output slides/dist/INTERVIEW_DECK.zh-cn.html",
    "ci:local": "npm run compile && npm test && npm run test:gate-validation && npm run test:frontend && cd frontend && npm run lint && npm run build",
    "ci:local:release": "node scripts/ci/local-release-loop.mjs",
    "ci:smoke:localhost": "hardhat run scripts/ci/smoke-deployed-localhost.ts --network localhost",
    "security-gate": "hardhat security-gate",
    "release:manifest": "hardhat run scripts/release/generate-manifest.ts",
    "release:frontend-manifest": "node scripts/release/frontend-build-manifest.mjs",
    "e2e:mainnet-read-only": "playwright test e2e/mainnet-read-only.spec.ts",
    "e2e:governance-smoke": "node scripts/ci/run-governance-smoke.mjs",
    "gate:release": "node scripts/ci/gate-release.mjs",
    "release:sign-b4-evidence": "hardhat run scripts/release/sign-b4-evidence.ts",
    "security-gate:b4-evidence": "hardhat run scripts/security-gate/check-b4-evidence.ts"
  }
}
